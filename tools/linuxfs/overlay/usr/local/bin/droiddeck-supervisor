#!/bin/sh
# DroidDeck container PID1 supervisor.
# Keeps the container (and optional base services such as DSH) alive while sessions are
# started/stopped on demand. A session is a child process; stopping it never stops this container.
BASE=/dd/container
CMD_FILE="$BASE/supervisor.cmd"
STATUS="$BASE/supervisor.status"
LOG="$BASE/supervisor.log"
SESSION_LOG="$BASE/session.log"
ENV_FILE="$BASE/session.env"
ARGS_FILE="$BASE/session.args"
PID_FILE="$BASE/session.pid"
EXIT_FILE="$BASE/session.exit"
SETPRIV=$(command -v setpriv) || { echo "supervisor: setpriv missing" >>"$LOG"; exit 1; }
session_pid=

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

session_env() {
  # Reuse the UID/GID/groups the app prepared for this container.
  [ -f "$ENV_FILE" ] && . "$ENV_FILE"
  DD_UID=${DD_UID:-10490}
  DD_GID=${DD_GID:-10490}
  DD_GROUPS=${DD_GROUPS:-$DD_UID}
}

child_alive() {
  [ -n "$session_pid" ] && kill -0 "$session_pid" 2>/dev/null
}

start_session() {
  if child_alive; then
    echo "busy $session_pid" >"$STATUS"
    return 1
  fi
  rm -f "$EXIT_FILE" "$PID_FILE"
  set -a
  [ -f "$ENV_FILE" ] && . "$ENV_FILE"
  set +a
  mode=${DD_MODE:-desktop}
  set -- "$mode"
  if [ -f "$ARGS_FILE" ]; then
    while IFS= read -r a; do set -- "$@" "$a"; done <"$ARGS_FILE"
  fi
  home=/root
  case "$mode" in desktop|lxqt) home=/home/droiddeck ;; esac
  log "start session mode=$mode args=$*"
  echo "starting $mode" >"$STATUS"
  # Own process group so stop can take KWin/Plasma/gamescope descendants down with it.
  if command -v setsid >/dev/null 2>&1; then
    setsid "$SETPRIV" --reuid="$DD_UID" --regid="$DD_GID" --groups="$DD_GROUPS" \
      --inh-caps=-all --bounding-set=-all -- \
      env HOME="$home" USER="$(id -un "$DD_UID" 2>/dev/null || echo droiddeck)" \
      /usr/local/bin/droiddeck-session "$mode" "$@" >>"$SESSION_LOG" 2>&1 &
  else
    "$SETPRIV" --reuid="$DD_UID" --regid="$DD_GID" --groups="$DD_GROUPS" \
      --inh-caps=-all --bounding-set=-all -- \
      env HOME="$home" USER="$(id -un "$DD_UID" 2>/dev/null || echo droiddeck)" \
      /usr/local/bin/droiddeck-session "$mode" "$@" >>"$SESSION_LOG" 2>&1 &
  fi
  session_pid=$!
  echo "$session_pid" >"$PID_FILE"
  echo "running $session_pid $mode" >"$STATUS"
  log "session pid=$session_pid"
  return 0
}

cleanup_session_processes() {
  # Daemonized children (Steam, KWin helpers) can survive the session process group. They belong
  # to this session, so clear them before declaring idle.
  for name in kwin_wayland kwin_wayland_wrapper gamescope plasmashell Xwayland steam steamwebhelper; do
    pkill -TERM -x "$name" 2>/dev/null || true
  done
  sleep 0.5
  for name in kwin_wayland kwin_wayland_wrapper gamescope plasmashell Xwayland steam steamwebhelper; do
    pkill -KILL -x "$name" 2>/dev/null || true
  done
}

stop_session() {
  if [ -z "$session_pid" ]; then
    echo "idle" >"$STATUS"
    return 0
  fi
  log "stopping session pid=$session_pid"
  kill -TERM -"$session_pid" 2>/dev/null || kill -TERM "$session_pid" 2>/dev/null || true
  i=0
  while kill -0 "$session_pid" 2>/dev/null && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
  done
  kill -KILL -"$session_pid" 2>/dev/null || kill -KILL "$session_pid" 2>/dev/null || true
  wait "$session_pid" 2>/dev/null
  cleanup_session_processes
  echo "0" >"$EXIT_FILE"
  rm -f "$PID_FILE"
  session_pid=
  echo "idle" >"$STATUS"
}

start_base_services() {
  if [ -x /usr/local/bin/droiddeck-dsh ]; then
    log "starting base DSH service"
    /usr/local/bin/droiddeck-dsh >"$BASE/dsh.log" 2>&1 &
  fi
}

session_env
rm -f "$CMD_FILE"
echo "supervisor ready pid=$$" >"$STATUS"
log "supervisor ready pid=$$"
start_base_services

while :; do
  if [ -f "$CMD_FILE" ]; then
    line=$(cat "$CMD_FILE" 2>/dev/null)
    rm -f "$CMD_FILE"
    case "$line" in
      start|"start "*)
        start_session
        ;;
      stop)
        stop_session
        ;;
      status)
        if child_alive; then echo "running $session_pid" >"$STATUS"; else echo "idle" >"$STATUS"; fi
        ;;
      shutdown)
        stop_session
        log "shutdown requested"
        exit 0
        ;;
      *) log "unknown command: $line" ;;
    esac
  fi
  sleep 0.3
  # Reap a finished session without blocking.
  if [ -n "$session_pid" ] && ! kill -0 "$session_pid" 2>/dev/null; then
    wait "$session_pid" 2>/dev/null
    rc=$?
    cleanup_session_processes
    echo "$rc" >"$EXIT_FILE"
    log "session exited pid=$session_pid rc=$rc"
    rm -f "$PID_FILE"
    session_pid=
    echo "idle" >"$STATUS"
  fi
done
