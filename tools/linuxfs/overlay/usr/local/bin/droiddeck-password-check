#!/bin/bash
# Runs as root via droiddeck-root; verifies the password supplied on stdin.
user="${1:-$(id -un 2>/dev/null)}"
IFS= read -r pw
line=$(getent shadow "$user" 2>/dev/null) || exit 1
hash=${line#*:}
hash=${hash%%:*}
[ -n "$hash" ] || exit 1
case "$hash" in
  '$6$'*)
    salt=${hash#\$6\$}
    salt=${salt%%\$*}
    calc=$(printf '%s' "$pw" | /usr/bin/openssl passwd -6 -salt "$salt" -stdin 2>/dev/null) || exit 1
    [ -n "$calc" ] && [ "$calc" = "$hash" ]
    ;;
  *)
    command -v /usr/bin/perl >/dev/null 2>&1 || exit 1
    calc=$(printf '%s' "$pw" | /usr/bin/perl -e 'my $pw=<STDIN>; $pw =~ s/\n\z//; print crypt($pw, $ARGV[0]);' "$hash" 2>/dev/null) || exit 1
    [ -n "$calc" ] && [ "$calc" = "$hash" ]
    ;;
esac
